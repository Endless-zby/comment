generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Hotel {
  id             Int       @id @default(autoincrement())
  hotelName      String    @map("hotel_name")
  ctripHotelId   String?   @unique @map("ctrip_hotel_id")
  fliggyHotelId  String?   @unique @map("fliggy_hotel_id")
  platformId     String?   @unique @map("platform_id")
  city           String?
  onboardDate    String?   @map("onboard_date")
  totalReviews   Int       @default(0) @map("total_reviews")
  avgScore       Float?    @map("avg_score")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  
  configs        Config[]
  reviews        Review[]
  fetchLogs      FetchLog[]
  aiReport       AiReport?
  alerts         Alert[]

  @@index([ctripHotelId])
  @@index([fliggyHotelId])
  @@index([platformId])
  @@map("hotels")
}

model Config {
  id              Int       @id @default(autoincrement())
  hotelId         Int       @map("hotel_id")
  fetchIntervalHr Int       @default(24) @map("fetch_interval_hr")
  pageSize        Int       @default(20) @map("page_size")
  fetchMode       String    @default("incremental") @map("fetch_mode")
  isActive        Boolean   @default(true) @map("is_active")
  lastFetchedAt   DateTime? @map("last_fetched_at")
  lastFetchedPage Int       @default(0) @map("last_fetched_page")
  totalFetched    Int       @default(0) @map("total_fetched")
  createdAt       DateTime  @default(now()) @map("created_at")
  
  hotel           Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reviews         Review[]
  fetchLogs       FetchLog[]

  @@map("configs")
}

model Review {
  id            Int       @id @default(autoincrement())
  hotelId       Int       @map("hotel_id")
  configId      Int?      @map("config_id")
  commentId     String    @map("comment_id")
  platform      String    @default("ctrip") @map("platform")
  rating        Float
  content       String?
  roomName      String?   @map("room_name")
  checkInDate   String?   @map("check_in_date")
  reviewer      String?
  reviewDate    String?   @map("review_date")
  hasImage      Boolean   @default(false) @map("has_image")
  imageList     String?   @map("image_list")
  hotelReply    String?   @map("hotel_reply")
  rawJson       String?   @map("raw_json")
  createdAt     DateTime  @default(now()) @map("created_at")
  
  hotel         Hotel     @relation(fields: [hotelId], references: [id])
  config        Config?   @relation(fields: [configId], references: [id], onDelete: SetNull)

  @@unique([commentId, platform])
  @@index([hotelId, platform])
  @@index([hotelId, reviewDate(sort: Desc)])
  @@index([hotelId, rating])
  @@index([hotelId, platform, reviewDate(sort: Desc)])
  @@index([configId])
  @@map("reviews")
}

model FetchLog {
  id            Int       @id @default(autoincrement())
  configId      Int       @map("config_id")
  hotelId       Int       @map("hotel_id")
  platform      String    @default("ctrip") @map("platform")
  success       Boolean   @default(false)
  fetchMode     String?   @map("fetch_mode")
  newCount      Int       @default(0) @map("new_count")
  totalFetched  Int       @default(0) @map("total_fetched")
  pagesFetched  Int       @default(0) @map("pages_fetched")
  error         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  
  hotel         Hotel     @relation(fields: [hotelId], references: [id])
  config        Config    @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId, createdAt(sort: Desc)])
  @@index([configId, platform, createdAt(sort: Desc)])
  @@map("fetch_logs")
}

model GlobalSetting {
  id            Int       @id @default(autoincrement())
  key           String    @unique
  value         String?
  description   String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("global_settings")
}

model AiReport {
  id            Int       @id @default(autoincrement())
  hotelId       Int       @map("hotel_id")
  summary       String
  weekRange     String    @map("week_range")
  hotelName     String    @map("hotel_name")
  reviewCount   Int       @default(0) @map("review_count")
  avgScore      Float?    @map("avg_score")
  createdAt     DateTime  @default(now()) @map("created_at")

  hotel         Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId])
  @@map("ai_reports")
}

model Alert {
  id            Int       @id @default(autoincrement())
  hotelId       Int       @map("hotel_id")
  reviewId      Int       @map("review_id")
  hotelName     String    @map("hotel_name")
  platform      String    @default("ctrip")
  rating        Float
  content       String?
  isRead        Boolean   @default(false) @map("is_read")
  createdAt     DateTime  @default(now()) @map("created_at")

  hotel         Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, isRead])
  @@index([createdAt(sort: Desc)])
  @@map("alerts")
}

model User {
  id                Int           @id @default(autoincrement())
  accountType       String        @default("web") @map("account_type")
  username          String?       @unique
  passwordHash      String?       @map("password_hash")
  wechatOpenid      String?       @unique @map("wechat_openid")
  wechatUnionId     String?       @map("wechat_union_id")
  miniProgramOpenid String?       @unique @map("mini_program_openid")
  nickname          String?
  avatarUrl         String?       @map("avatar_url")
  status            String        @default("pending")
  roleId            Int?          @map("role_id")
  approvedAt        DateTime?     @map("approved_at")
  approvedBy        Int?          @map("approved_by")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  role              Role?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  sessions          AuthSession[]

  @@index([status])
  @@index([roleId])
  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  isAdmin     Boolean          @default(false) @map("is_admin")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  users       User[]
  permissions PagePermission[]

  @@map("roles")
}

model PagePermission {
  id        Int      @id @default(autoincrement())
  roleId    Int      @map("role_id")
  pageKey   String   @map("page_key")
  canAccess Boolean  @default(true) @map("can_access")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, pageKey])
  @@index([pageKey])
  @@map("page_permissions")
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  operatorId   Int?     @map("operator_id")
  targetUserId Int?     @map("target_user_id")
  action       String
  payload      String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([operatorId])
  @@index([targetUserId])
  @@index([action])
  @@map("audit_logs")
}

model AuthSession {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}
