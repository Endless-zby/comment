generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Hotel {
  id             Int       @id @default(autoincrement())
  hotelName      String    @map("hotel_name")
  ctripHotelId   String?   @unique @map("ctrip_hotel_id")
  fliggyHotelId  String?   @unique @map("fliggy_hotel_id")
  platformId     String?   @unique @map("platform_id")
  city           String?
  onboardDate    String?   @map("onboard_date")
  totalReviews   Int       @default(0) @map("total_reviews")
  avgScore       Float?    @map("avg_score")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  
  configs        Config[]
  reviews        Review[]
  fetchLogs      FetchLog[]
  aiReport       AiReport?

  @@index([ctripHotelId])
  @@index([fliggyHotelId])
  @@index([platformId])
  @@map("hotels")
}

model Config {
  id              Int       @id @default(autoincrement())
  hotelId         Int       @map("hotel_id")
  fetchIntervalHr Int       @default(24) @map("fetch_interval_hr")
  pageSize        Int       @default(20) @map("page_size")
  fetchMode       String    @default("incremental") @map("fetch_mode")
  isActive        Boolean   @default(true) @map("is_active")
  lastFetchedAt   DateTime? @map("last_fetched_at")
  lastFetchedPage Int       @default(0) @map("last_fetched_page")
  totalFetched    Int       @default(0) @map("total_fetched")
  createdAt       DateTime  @default(now()) @map("created_at")
  
  hotel           Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reviews         Review[]
  fetchLogs       FetchLog[]

  @@map("configs")
}

model Review {
  id            Int       @id @default(autoincrement())
  hotelId       Int       @map("hotel_id")
  configId      Int?      @map("config_id")
  commentId     String    @map("comment_id")
  platform      String    @default("ctrip") @map("platform")
  rating        Float
  content       String?
  roomName      String?   @map("room_name")
  checkInDate   String?   @map("check_in_date")
  reviewer      String?
  reviewDate    String?   @map("review_date")
  hasImage      Boolean   @default(false) @map("has_image")
  imageList     String?   @map("image_list")
  hotelReply    String?   @map("hotel_reply")
  rawJson       String?   @map("raw_json")
  createdAt     DateTime  @default(now()) @map("created_at")
  
  hotel         Hotel     @relation(fields: [hotelId], references: [id])
  config        Config?   @relation(fields: [configId], references: [id], onDelete: SetNull)

  @@unique([commentId, platform])
  @@index([hotelId, platform])
  @@index([hotelId, reviewDate(sort: Desc)])
  @@index([hotelId, rating])
  @@index([hotelId, platform, reviewDate(sort: Desc)])
  @@index([configId])
  @@map("reviews")
}

model FetchLog {
  id            Int       @id @default(autoincrement())
  configId      Int       @map("config_id")
  hotelId       Int       @map("hotel_id")
  platform      String    @default("ctrip") @map("platform")
  success       Boolean   @default(false)
  fetchMode     String?   @map("fetch_mode")
  newCount      Int       @default(0) @map("new_count")
  totalFetched  Int       @default(0) @map("total_fetched")
  pagesFetched  Int       @default(0) @map("pages_fetched")
  error         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  
  hotel         Hotel     @relation(fields: [hotelId], references: [id])
  config        Config    @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId, createdAt(sort: Desc)])
  @@index([configId, platform, createdAt(sort: Desc)])
  @@map("fetch_logs")
}

model GlobalSetting {
  id            Int       @id @default(autoincrement())
  key           String    @unique
  value         String?
  description   String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("global_settings")
}

model AiReport {
  id            Int       @id @default(autoincrement())
  hotelId       Int       @map("hotel_id")
  summary       String
  weekRange     String    @map("week_range")
  hotelName     String    @map("hotel_name")
  reviewCount   Int       @default(0) @map("review_count")
  avgScore      Float?    @map("avg_score")
  createdAt     DateTime  @default(now()) @map("created_at")

  hotel         Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId])
  @@map("ai_reports")
}